{
  "expo": {
    "name": "Capy Board",
    "slug": "capyboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dccommits.capyboard"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDD447",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dccommits.capyboard",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6E7D2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "capyboard",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9c0bb927-d63a-41cc-9043-d5e14684ee20"
      }
    },
    "owner": "tazmaniack",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9c0bb927-d63a-41cc-9043-d5e14684ee20"
    }
  }
}
